# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Router model (also the default model for regular Workers)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Fast model: fast-task Workers, and the default semantic judge
MIR_FAST_MODEL_ID=nvidia/nemotron-3.5-lightning:free

# Thinking level: off|minimal|low|medium|high|xhigh|max
MIR_THINKING=medium

# Cap on max_tokens per request: pi-ai otherwise sends none, so OpenRouter
# reserves the whole context window and 402s on a small balance.
MIR_MAX_TOKENS=8192

# OpenRouter provider routing (opt-in): comma-separated.
# OPENROUTER_PROVIDER_ONLY=deepinfra
# OPENROUTER_QUANTIZATIONS=fp8

# ---------------------------------------------------------------------------
# Router scheduling
# ---------------------------------------------------------------------------
# Coalescing window applied only when the Router is idle (never reset mid-batch,
# so a steady event stream cannot starve it).
MIR_BATCH_WINDOW_MS=500
# Max items folded into one Router prompt; the rest go in the next turn.
MIR_MAX_BATCH_SIZE=20
# Wall-clock cap on one Router turn before it is aborted and retried.
MIR_ROUTER_TURN_TIMEOUT_MS=300000
MIR_ROUTER_RETRY_BACKOFF_MS=2000
# Attempts per event before it is marked failed and the human is told.
MIR_MAX_TRIGGER_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
MIR_MAX_WORKERS=8
# Tasks beyond MIR_MAX_WORKERS wait here; a full queue rejects the dispatch.
MIR_MAX_DISPATCH_QUEUE=50
# How long a finished Worker waits for follow-up events before exiting (ms)
MIR_WORKER_IDLE_MS=120000
# Heartbeat interval, independent of turn progress (0 disables)
MIR_WORKER_HEARTBEAT_MS=15000

# Worker capabilities: what a Worker's tools may reach. Either a JSON object or
# a grant list. Anything not granted is denied.
#   JSON:  {"net":false,"fs":"ro","mcp":true,"codemode":true}
#   list:  net,fs:ro,mcp,codemode   (or "all")
MIR_CAPABILITIES=all

# Extra tool policy on top of capabilities (comma-separated globs).
# MIR_WORKER_TOOL_ALLOW=read,write,codemode,mcp__*
# MIR_WORKER_TOOL_DENY=bash,write

# MCP servers for Workers. Values may use ${env:NAME} to pull credentials from
# the environment at connect time; resolved values are redacted from logs.
MIR_MCP_CONFIG_PATH=mcp.config.json

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
MIR_HTTP_HOST=127.0.0.1
MIR_HTTP_PORT=4599
# Shared token the caller must send in `x-mir-token`.
MIR_HTTP_TOKEN=
# Or HMAC-SHA256 over `<timestamp>.<body>` in `x-mir-signature`
# (`x-mir-timestamp` carries the unix seconds; 5-minute replay window).
MIR_HTTP_HMAC_SECRET=
# Per-kind admission: ignore | candidate | respond_only
MIR_HTTP_POLICY=candidate
MIR_QUEUE_POLICY=candidate

# Durable file queue (offline-friendly source)
MIR_QUEUE_DIR=~/.local/share/mir/queue
# Polling fallback for filesystems where fs.watch misses events (0 disables)
MIR_QUEUE_POLL_MS=2000

# ---------------------------------------------------------------------------
# Hands (execution environments — see docs/hands.md)
# ---------------------------------------------------------------------------
MIR_HANDS=true
# Endpoint listener: hands dial OUT to this address.
MIR_HANDS_HOST=127.0.0.1
MIR_HANDS_PORT=4700
# 0 = no listener (local hand only). Brains reach the hub on this socket.
MIR_HANDS_SOCKET=~/.local/share/mir/hands.sock
# TLS for the endpoint listener. Use it for anything that is not loopback.
# MIR_HANDS_TLS_CERT=/etc/mir/hub.crt
# MIR_HANDS_TLS_KEY=/etc/mir/hub.key
MIR_HANDS_HEARTBEAT_MS=15000
MIR_HANDS_OFFLINE_GRACE_MS=90000
MIR_HANDS_REQUEST_TIMEOUT_MS=600000
# Remote hands: register one with `mir hands add <id>`, then run on that machine
#   mir-endpoint --hub <host:port> --id <id> --token <token> \
#                --root ~/work --allow git,ls,cat,node --fs rw \
#                --allow-net github.com,registry.npmjs.org \
#                --deny-read ~/.ssh --deny-read ~/.aws
# The OS sandbox is on by default; --no-sandbox is an explicit downgrade.

# The daemon's own machine, registered as a hand so a fresh install works.
MIR_HANDS_LOCAL=true
MIR_HANDS_LOCAL_ROOTS=.
MIR_HANDS_LOCAL_ALLOW=git,ls,cat,pwd,rg,node,npm,pnpm,npx,make,tsc
MIR_HANDS_LOCAL_DENY=
MIR_HANDS_LOCAL_FS=rw
MIR_HANDS_LOCAL_EXEC=true
MIR_HANDS_LOCAL_GIT=true
# Grant a shell only if you accept that the executable allowlist stops applying.
MIR_HANDS_LOCAL_SHELL=false
# OS sandbox for the local hand (paths + network). Off for a dev machine.
MIR_HANDS_LOCAL_SANDBOX=false
# Hosts the local hand's processes may reach (empty = no network).
MIR_HANDS_LOCAL_ALLOW_NET=
MIR_HANDS_LOCAL_DENY_NET=
MIR_HANDS_LOCAL_ALLOW_LOCAL_BINDING=false
MIR_HANDS_LOCAL_UNIX_SOCKETS=
# Paths the local hand may not read / write.
MIR_HANDS_LOCAL_DENY_READ=~/.ssh,~/.aws
MIR_HANDS_LOCAL_DENY_WRITE=
MIR_HANDS_LOCAL_MAX_CONCURRENT=2
MIR_HANDS_TIMEOUT_MS=120000
MIR_HANDS_MAX_TIMEOUT_MS=900000
MIR_HANDS_MAX_OUTPUT=262144

# ---------------------------------------------------------------------------
# Trigger admission (§3.1 two-stage filter)
# ---------------------------------------------------------------------------
# Semantic (model-judged) slow path. Off = every candidate wakes the Router.
MIR_SEMANTIC_FILTER=true
# Model used for the judge (defaults to MIR_FAST_MODEL_ID)
# MIR_SEMANTIC_MODEL=nvidia/nemotron-3.5-lightning:free
# One natural-language policy...
MIR_SEMANTIC_POLICY=Act when a message asks for work, reports a problem, or asks a question the agent can answer. Ignore casual chat, acknowledgements, and bot noise.
# ...or a JSON array of {name, prompt, enabled}
# MIR_SEMANTIC_POLICIES=[{"name":"work","prompt":"..."}]
# Cap on judged events per minute (0 = unlimited)
MIR_SEMANTIC_MAX_PER_MINUTE=120

# Programmatic (fast path) policies
MIR_ALLOWED_USERS=
MIR_REQUIRE_MENTION=

# ---------------------------------------------------------------------------
# Watchdog (§6)
# ---------------------------------------------------------------------------
MIR_WATCHDOG=true
MIR_WATCHDOG_INTERVAL_MS=30000
# A busy Worker with no heartbeat for this long is stuck and is stopped.
MIR_WATCHDOG_STUCK_MS=300000
# A Router turn in flight longer than this is hung and is aborted.
MIR_WATCHDOG_ROUTER_MS=360000
# Cap on watchdog model turns per hour (mechanical recovery is not capped)
MIR_WATCHDOG_MAX_TURNS_PER_HOUR=30
# MIR_WATCHDOG_MODEL=

# ---------------------------------------------------------------------------
# State (compute/state separation, §5.1)
# ---------------------------------------------------------------------------
# Durable daemon state: trigger log, tasks, workers, threads, recall objects.
MIR_STATE_DIR=~/.local/share/mir/state
# Router session transcript
MIR_ROUTER_SESSION=~/.local/share/mir/router.session
# Worker sessions + shared worker SQLite
MIR_WORKER_STATE_DIR=~/.local/share/mir/worker-state
# Local Unix socket for the daemon↔worker control channel
MIR_SOCKET_PATH=~/.local/share/mir/daemon.sock

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# debug|info|warn|error
MIR_LOG_LEVEL=info
# json|text (default: text on a TTY, json otherwise)
MIR_LOG_FORMAT=json
# Prometheus /metrics + /healthz endpoint (0 = disabled)
MIR_METRICS_PORT=0
MIR_METRICS_HOST=127.0.0.1
# Retention
MIR_EVENT_RETENTION_MS=604800000
MIR_OBJECT_RETENTION=5000

# ---------------------------------------------------------------------------
# Client API — the door a display connects to (`mir serve`)
# ---------------------------------------------------------------------------
# Where the brain serves threads, entries, say and stop. Off unless a socket is
# named. `mir serve` refuses to start without a token: a brain that answers
# anyone who can open a socket is not one to leave running.
MIR_API_SOCKET=~/.local/share/mir/brain.sock
MIR_API_TOKEN=
