{
	"name": "mir",
	"version": "1.0.0",
	"description": "Super-agent 'mir' \u2014 Router+Workers, pm2 process manager, channel-based event sources",
	"private": true,
	"type": "module",
	"bin": {
		"mir": "bin/mir.js"
	},
	"scripts": {
		"dev": "tsx src/index.ts daemon",
		"daemon": "pm2 start ecosystem.config.cjs",
		"stop": "pm2 delete mir-daemon",
		"restart": "pm2 restart mir-daemon",
		"logs": "pm2 logs mir-daemon",
		"send": "tsx src/index.ts send",
		"endpoint": "tsx src/endpoint/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "node --import tsx --test --test-concurrency=6 test/*.test.ts",
		"test:watch": "node --import tsx --test --test-concurrency=6 --watch test/*.test.ts",
		"smoke:hands": "tsx scripts/smoke-hands.ts",
		"smoke:brain": "tsx scripts/smoke-brain.ts",
		"trace": "tsx scripts/trace.ts",
		"test:sandbox": "MIR_SANDBOX_TESTS=1 node --import tsx --test test/hands-sandbox.test.ts test/hands-confined.test.ts"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.82",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@lancedb/lancedb": "0.41.0",
		"pm2": "^5.4.0",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	},
	"files": [
		"bin/",
		"dist/",
		"skills/",
		"docs/",
		"agent.manifest.json",
		"ecosystem.config.cjs",
		"README.md",
		"CONTEXT.md"
	],
	"engines": {
		"node": ">=22"
	}
}
